# Build subdirectories.
/*build*
!/build-aux
!/build_msvc

*.pyc

# Only ignore unexpected patches
*.patch
!contrib/guix/patches/*.patch
!depends/patches/**/*.patch

/CMakeUserPresets.json

# Previous releases
/releases

#build tests
test/lint/test_runner/target/
# Generated by CMake in build/test/; local symlinks into the source tree are optional.
test/config.ini

/guix-build-*

/ci/scratch/
